{
  "name": "continuity-local",
  "version": "0.1.0",
  "private": true,
  "description": "Persistent context for interchangeable agents",
  "type": "module",
  "license": "Apache-2.0",
  "engines": { "node": ">=24.13.0" },
  "packageManager": "pnpm@10.30.1",
  "bin": { "continuity": "dist/packages/cli/src/index.js" },
