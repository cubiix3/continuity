{
  "name": "continuity-local",
  "version": "0.1.0",
  "private": true,
  "description": "Local continuity, memory and structured handoffs for AI agents",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/cubiix3/continuity.git"
  },
  "homepage": "https://github.com/cubiix3/continuity#readme",
  "bugs": "https://github.com/cubiix3/continuity/issues",
  "keywords": ["ai-agents", "developer-tools", "mcp", "local-first", "memory"],
  "files": [
    "dist/packages",
    "README.md",
    "LICENSE",
    "docs",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": "./dist/packages/sdk/src/index.js",
    "./core": "./dist/packages/core/src/index.js",
    "./generic": "./dist/packages/adapter-generic/src/index.js"
  },
  "engines": {
    "node": ">=24.13.0"
  },
  "packageManager": "pnpm@10.30.1",
  "bin": {
    "continuity": "dist/packages/cli/src/index.js"
  },
  "scripts": {
    "build": "node scripts/clean-build.mjs && tsc -p tsconfig.build.json && node scripts/copy-dashboard.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests --exclude '**/*.spec.ts'",
    "lint": "eslint .",
    "prepack": "pnpm build",
    "test:pack": "node scripts/pack-smoke.mjs",
    "test:runtime-pack": "node scripts/runtime-smoke.mjs",
    "test:ui": "playwright test",
    "baseline": "node scripts/retrieval-baseline.mjs",
    "test:agents": "node scripts/real-agents.mjs",
    "continuity": "node dist/packages/cli/src/index.js",
    "check": "pnpm build && pnpm typecheck && pnpm test && pnpm lint"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "commander": "^15.0.0",
    "ignore": "^7.0.9",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "eslint": "^10.11.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^5.0.1"
  }
}
